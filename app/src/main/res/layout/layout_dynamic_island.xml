<?xml version="1.0" encoding="utf-8"?>
<LinearLayout xmlns:android="http://schemas.android.com/apk/res/android"
    android:id="@+id/island_root"
    android:layout_width="wrap_content"
    android:layout_height="44dp"
    android:orientation="horizontal"
    android:gravity="center_vertical"
    android:background="@drawable/bg_dynamic_island"
    android:elevation="14dp"
    android:paddingStart="8dp"
    android:paddingEnd="8dp"
    android:paddingTop="3dp"
    android:paddingBottom="3dp"
    android:clipToPadding="false"
    android:clipChildren="false">

    <!-- Island Leading Icon (Avatar / Battery Icon) -->
    <FrameLayout
        android:id="@+id/island_icon_container"
        android:layout_width="34dp"
        android:layout_height="34dp"
        android:background="@drawable/bg_floating_bubble"
        android:clickable="true"
        android:focusable="true">

        <ImageView
            android:id="@+id/iv_island_icon"
            android:layout_width="30dp"
            android:layout_height="30dp"
            android:layout_gravity="center"
            android:src="@drawable/ic_virus_avatar"
            android:scaleType="centerCrop" />
    </FrameLayout>

    <!-- Main Dynamic Island Content -->
    <LinearLayout
        android:id="@+id/ll_island_body"
        android:layout_width="wrap_content"
        android:layout_height="match_parent"
        android:orientation="horizontal"
        android:gravity="center_vertical"
        android:layout_marginStart="8dp"
        android:layout_marginEnd="4dp">

        <!-- Status / Camouflage Label -->
        <TextView
            android:id="@+id/tv_island_title"
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:text="OmniSolve"
            android:textColor="#E2E8F0"
            android:textSize="12sp"
            android:textStyle="bold"
            android:maxLines="1" />

        <!-- Prominent Answer / Camouflage Badge -->
        <TextView
            android:id="@+id/tv_island_answer"
            android:layout_width="wrap_content"
            android:minWidth="34dp"
            android:layout_height="32dp"
            android:layout_marginStart="8dp"
            android:paddingStart="6dp"
            android:paddingEnd="6dp"
            android:background="@drawable/bg_answer_box"
            android:gravity="center"
            android:text="?"
            android:textColor="#10B981"
            android:textSize="15sp"
            android:textStyle="bold" />

    </LinearLayout>

    <!-- Expandable Controls Tray -->
    <LinearLayout
        android:id="@+id/island_expanded_controls"
        android:layout_width="wrap_content"
        android:layout_height="match_parent"
        android:orientation="horizontal"
        android:gravity="center_vertical"
        android:visibility="gone"
        android:layout_marginStart="4dp">

        <!-- Scan / Play Action -->
        <FrameLayout
            android:id="@+id/btn_island_scan"
            android:layout_width="32dp"
            android:layout_height="32dp"
            android:layout_marginStart="4dp"
            android:background="@drawable/bg_scan_button"
            android:clickable="true"
            android:focusable="true">

            <ImageView
                android:id="@+id/iv_island_scan_icon"
                android:layout_width="18dp"
                android:layout_height="18dp"
                android:layout_gravity="center"
                android:src="@android:drawable/ic_media_play"
                android:tint="#FFFFFF" />
        </FrameLayout>

        <!-- Toggle Gemini Window -->
        <ImageView
            android:id="@+id/btn_island_toggle_window"
            android:layout_width="32dp"
            android:layout_height="32dp"
            android:layout_marginStart="6dp"
            android:padding="5dp"
            android:background="@drawable/bg_chip_action"
            android:src="@android:drawable/ic_menu_view"
            android:tint="#38BDF8"
            android:clickable="true"
            android:focusable="true" />

        <!-- Bot Toggle Button -->
        <ImageView
            android:id="@+id/btn_island_bot_toggle"
            android:layout_width="32dp"
            android:layout_height="32dp"
            android:layout_marginStart="6dp"
            android:padding="5dp"
            android:background="@drawable/bg_chip_action"
            android:src="@android:drawable/ic_menu_myplaces"
            android:tint="#64748B"
            android:clickable="true"
            android:focusable="true" />

        <!-- Close / Minimize Tray Button -->
        <ImageView
            android:id="@+id/btn_island_close"
            android:layout_width="28dp"
            android:layout_height="28dp"
            android:layout_marginStart="6dp"
            android:src="@android:drawable/ic_menu_close_clear_cancel"
            android:tint="#8E9BB0"
            android:clickable="true"
            android:focusable="true" />

    </LinearLayout>

</LinearLayout>
