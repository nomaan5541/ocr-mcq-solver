<?xml version="1.0" encoding="utf-8"?>
<LinearLayout xmlns:android="http://schemas.android.com/apk/res/android"
    android:id="@+id/gemini_window_root"
    android:layout_width="match_parent"
    android:layout_height="match_parent"
    android:orientation="vertical"
    android:background="@drawable/bg_gemini_window"
    android:elevation="20dp"
    android:clipToOutline="true">

    <!-- Top Drag & Control Header -->
    <LinearLayout
        android:id="@+id/header_drag_area"
        android:layout_width="match_parent"
        android:layout_height="44dp"
        android:orientation="horizontal"
        android:gravity="center_vertical"
        android:background="@drawable/bg_gemini_header"
        android:paddingStart="8dp"
        android:paddingEnd="6dp">

        <!-- Virus Avatar icon and Title -->
        <ImageView
            android:layout_width="22dp"
            android:layout_height="22dp"
            android:src="@drawable/ic_virus_avatar"
            android:layout_marginEnd="6dp" />

        <TextView
            android:layout_width="0dp"
            android:layout_height="wrap_content"
            android:layout_weight="1"
            android:text="⚡ OmniSolve • virus_boss"
            android:textColor="#F1F5F9"
            android:textSize="11sp"
            android:textStyle="bold"
            android:ellipsize="end"
            android:singleLine="true" />

        <!-- Auto-Solve Button (Captures screen & fills Gemini) -->
        <TextView
            android:id="@+id/btn_window_scan"
            android:layout_width="wrap_content"
            android:layout_height="28dp"
            android:background="@drawable/bg_chip_action"
            android:gravity="center"
            android:paddingStart="6dp"
            android:paddingEnd="6dp"
            android:text="⚡ Solve"
            android:textColor="#38BDF8"
            android:textSize="10sp"
            android:textStyle="bold"
            android:clickable="true"
            android:focusable="true"
            android:layout_marginEnd="4dp" />

        <!-- Size Preset Toggle (S / M / L) -->
        <TextView
            android:id="@+id/btn_window_size"
            android:layout_width="wrap_content"
            android:layout_height="28dp"
            android:background="@drawable/bg_chip_action"
            android:gravity="center"
            android:paddingStart="6dp"
            android:paddingEnd="6dp"
            android:text="📐 S"
            android:textColor="#10B981"
            android:textSize="10sp"
            android:textStyle="bold"
            android:clickable="true"
            android:focusable="true"
            android:layout_marginEnd="4dp" />

        <!-- Opacity / Stealth Toggle -->
        <TextView
            android:id="@+id/btn_window_opacity"
            android:layout_width="wrap_content"
            android:layout_height="28dp"
            android:background="@drawable/bg_chip_action"
            android:gravity="center"
            android:paddingStart="5dp"
            android:paddingEnd="5dp"
            android:text="👁 100%"
            android:textColor="#94A3B8"
            android:textSize="10sp"
            android:clickable="true"
            android:focusable="true"
            android:layout_marginEnd="4dp" />

        <!-- Minimize Button -->
        <ImageView
            android:id="@+id/btn_window_minimize"
            android:layout_width="24dp"
            android:layout_height="24dp"
            android:padding="3dp"
            android:src="@android:drawable/ic_menu_revert"
            android:tint="#94A3B8"
            android:clickable="true"
            android:focusable="true"
            android:layout_marginEnd="2dp" />

        <!-- Close / Stop Button -->
        <ImageView
            android:id="@+id/btn_window_close"
            android:layout_width="24dp"
            android:layout_height="24dp"
            android:padding="3dp"
            android:src="@android:drawable/ic_menu_close_clear_cancel"
            android:tint="#EF4444"
            android:clickable="true"
            android:focusable="true" />

    </LinearLayout>

    <!-- Page Load Progress Bar -->
    <ProgressBar
        android:id="@+id/web_progress_bar"
        style="?android:attr/progressBarStyleHorizontal"
        android:layout_width="match_parent"
        android:layout_height="2dp"
        android:indeterminate="false"
        android:max="100"
        android:progressDrawable="@android:drawable/progress_horizontal"
        android:visibility="gone" />

    <!-- Main Gemini Web Content + Corner Resize Handle -->
    <RelativeLayout
        android:layout_width="match_parent"
        android:layout_height="0dp"
        android:layout_weight="1">

        <WebView
            android:id="@+id/gemini_webview"
            android:layout_width="match_parent"
            android:layout_height="match_parent" />

        <!-- Bottom-Right Resize Handle Grip -->
        <FrameLayout
            android:id="@+id/btn_resize_grip"
            android:layout_width="28dp"
            android:layout_height="28dp"
            android:layout_alignParentEnd="true"
            android:layout_alignParentBottom="true"
            android:background="#991A2130"
            android:clickable="true"
            android:focusable="true">

            <ImageView
                android:layout_width="16dp"
                android:layout_height="16dp"
                android:layout_gravity="center"
                android:src="@android:drawable/ic_menu_rotate"
                android:tint="#38BDF8" />
        </FrameLayout>

    </RelativeLayout>

</LinearLayout>
