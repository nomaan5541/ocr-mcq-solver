<?xml version="1.0" encoding="utf-8"?>
<ScrollView xmlns:android="http://schemas.android.com/apk/res/android"
    android:layout_width="match_parent"
    android:layout_height="match_parent"
    android:background="#0A0D14"
    android:padding="16dp">

    <LinearLayout
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:orientation="vertical">

        <!-- Virus Branding Banner Header -->
        <LinearLayout
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:background="#121826"
            android:gravity="center"
            android:orientation="vertical"
            android:padding="18dp"
            android:layout_marginBottom="16dp">

            <!-- Virus Avatar Image -->
            <FrameLayout
                android:layout_width="84dp"
                android:layout_height="84dp"
                android:background="@drawable/bg_floating_bubble"
                android:padding="2dp">

                <ImageView
                    android:id="@+id/iv_main_avatar"
                    android:layout_width="80dp"
                    android:layout_height="80dp"
                    android:layout_gravity="center"
                    android:src="@drawable/virus_logo"
                    android:scaleType="centerCrop" />
            </FrameLayout>

            <TextView
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:layout_marginTop="10dp"
                android:text="⚡ OCR MCQ Solver"
                android:textColor="#00F2FE"
                android:textSize="22sp"
                android:textStyle="bold" />

            <TextView
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:layout_marginTop="2dp"
                android:text="Created by virus_boss 🔥"
                android:textColor="#A78BFA"
                android:textSize="13sp"
                android:textStyle="bold" />

            <TextView
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:layout_marginTop="4dp"
                android:text="Next-Gen Stealth MCQ AI Solver"
                android:textColor="#94A3B8"
                android:textSize="12sp" />
        </LinearLayout>

        <!-- Instructions & Detailing Card -->
        <LinearLayout
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:background="#161B2E"
            android:orientation="vertical"
            android:padding="16dp"
            android:layout_marginBottom="16dp">

            <TextView
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:text="📖 How to Use &amp; Instructions"
                android:textColor="#38BDF8"
                android:textSize="15sp"
                android:textStyle="bold" />

            <TextView
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:layout_marginTop="8dp"
                android:text="• Step 1: Login to Google / Gemini first to unlock maximum AI speed with zero rate limits.\n• Step 2: Grant the 2 required permissions below.\n• Step 3: Tap 'Start Overlay' and open your exam or Chrome.\n• Step 4: Single-Tap the floating virus icon to solve.\n• Step 5 (Ghost Mode): Double-Tap the floating virus icon anytime to turn it 95% invisible (Dead-Pixel Mode)."
                android:textColor="#CBD5E1"
                android:textSize="12sp"
                android:lineSpacingExtra="3dp" />
        </LinearLayout>

        <!-- 1. Google Account Login Card -->
        <LinearLayout
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:background="#121826"
            android:orientation="vertical"
            android:padding="16dp"
            android:layout_marginBottom="16dp">

            <TextView
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:text="1. Google / Gemini Account"
                android:textColor="#F0F4FD"
                android:textSize="15sp"
                android:textStyle="bold" />

            <TextView
                android:id="@+id/tv_google_status"
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:layout_marginTop="6dp"
                android:text="Checking Login Status..."
                android:textColor="#F59E0B"
                android:textSize="13sp"
                android:textStyle="bold" />

            <Button
                android:id="@+id/btn_login_google"
                android:layout_width="match_parent"
                android:layout_height="48dp"
                android:layout_marginTop="10dp"
                android:backgroundTint="#7C3AED"
                android:text="🔑 Log into Google / Gemini"
                android:textColor="#FFFFFF"
                android:textSize="14sp"
                android:textStyle="bold" />

        </LinearLayout>

        <!-- 2. Display Mode Selector Card -->
        <LinearLayout
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:background="#121826"
            android:orientation="vertical"
            android:padding="16dp"
            android:layout_marginBottom="16dp">

            <TextView
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:text="2. Overlay Display Mode"
                android:textColor="#F0F4FD"
                android:textSize="15sp"
                android:textStyle="bold" />

            <RadioGroup
                android:id="@+id/rg_display_mode"
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:layout_marginTop="6dp">

                <RadioButton
                    android:id="@+id/rb_stealth_mode"
                    android:layout_width="match_parent"
                    android:layout_height="wrap_content"
                    android:checked="true"
                    android:paddingTop="4dp"
                    android:paddingBottom="4dp"
                    android:text="🥷 Stealth Option-Only Mode\n(Gemini runs invisibly; bubble shows ONLY A/B/C/D)"
                    android:textColor="#E2E8F0"
                    android:textSize="12sp" />

                <RadioButton
                    android:id="@+id/rb_window_mode"
                    android:layout_width="match_parent"
                    android:layout_height="wrap_content"
                    android:layout_marginTop="4dp"
                    android:paddingTop="4dp"
                    android:paddingBottom="4dp"
                    android:text="📱 Visible Window Mode\n(Shows floating mini Gemini chat card on screen)"
                    android:textColor="#E2E8F0"
                    android:textSize="12sp" />

            </RadioGroup>

        </LinearLayout>

        <!-- 3. Permissions Status Card -->
        <LinearLayout
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:background="#121826"
            android:orientation="vertical"
            android:padding="16dp"
            android:layout_marginBottom="16dp">

            <TextView
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:text="3. System Permissions"
                android:textColor="#F0F4FD"
                android:textSize="15sp"
                android:textStyle="bold" />

            <TextView
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:layout_marginTop="8dp"
                android:text="• Draw Over Other Apps:"
                android:textColor="#8E9BB0"
                android:textSize="12sp" />

            <TextView
                android:id="@+id/tv_overlay_status"
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:text="Checking..."
                android:textColor="#00F2FE"
                android:textSize="13sp"
                android:textStyle="bold" />

            <TextView
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:layout_marginTop="8dp"
                android:text="• Screen Capture Authorization:"
                android:textColor="#8E9BB0"
                android:textSize="12sp" />

            <TextView
                android:id="@+id/tv_capture_status"
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:text="Not Authorized (Prompts on Start)"
                android:textColor="#8E9BB0"
                android:textSize="13sp"
                android:textStyle="bold" />
        </LinearLayout>

        <!-- Main Start / Stop Button -->
        <Button
            android:id="@+id/btn_toggle_overlay"
            android:layout_width="match_parent"
            android:layout_height="56dp"
            android:backgroundTint="#00F2FE"
            android:text="Start Real-Time Overlay Service"
            android:textColor="#000000"
            android:textSize="15sp"
            android:textStyle="bold"
            android:layout_marginBottom="16dp" />

        <!-- Star & Follow virus_boss Card -->
        <LinearLayout
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:background="#161B2E"
            android:gravity="center"
            android:orientation="vertical"
            android:padding="16dp">

            <TextView
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:text="⭐ Support the Project"
                android:textColor="#FBBF24"
                android:textSize="14sp"
                android:textStyle="bold" />

            <TextView
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:layout_marginTop="4dp"
                android:gravity="center"
                android:text="If you like this app, please give it a Star on GitHub and follow virus_boss!"
                android:textColor="#94A3B8"
                android:textSize="12sp" />

            <Button
                android:id="@+id/btn_star_github"
                android:layout_width="match_parent"
                android:layout_height="44dp"
                android:layout_marginTop="10dp"
                android:backgroundTint="#1F2937"
                android:text="⭐ Star on GitHub &amp; Follow @virus_boss"
                android:textColor="#F3F4F6"
                android:textSize="13sp" />
        </LinearLayout>

    </LinearLayout>
</ScrollView>
