<?xml version="1.0" encoding="utf-8"?>
<layer-list xmlns:android="http://schemas.android.com/apk/res/android">
    <!-- Crystal Glass Inner Fill (Light) -->
    <item>
        <shape android:shape="rectangle">
            <gradient
                android:startColor="#E8FFFFFF"
                android:centerColor="#F0F8FAFC"
                android:endColor="#E0F1F5F9"
                android:angle="270" />
            <corners android:radius="22dp" />
        </shape>
    </item>
    <!-- Crystal Specular Highlight -->
    <item android:top="0dp" android:bottom="0dp">
        <shape android:shape="rectangle">
            <gradient
                android:startColor="#40FFFFFF"
                android:endColor="#10FFFFFF"
                android:angle="270" />
            <corners android:radius="22dp" />
        </shape>
    </item>
    <!-- Crystal Rim Border -->
    <item>
        <shape android:shape="rectangle">
            <corners android:radius="22dp" />
            <stroke
                android:width="1dp"
                android:color="#4000B8E0" />
        </shape>
    </item>
</layer-list>
