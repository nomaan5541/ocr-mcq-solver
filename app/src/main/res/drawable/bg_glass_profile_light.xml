<?xml version="1.0" encoding="utf-8"?>
<layer-list xmlns:android="http://schemas.android.com/apk/res/android">
    <!-- Crystal Glass Profile Circle (Light) -->
    <item>
        <shape android:shape="oval">
            <gradient
                android:startColor="#E0FFFFFF"
                android:endColor="#D0F1F5F9"
                android:angle="270" />
        </shape>
    </item>
    <item>
        <shape android:shape="oval">
            <stroke
                android:width="1.2dp"
                android:color="#3000B8E0" />
        </shape>
    </item>
</layer-list>
