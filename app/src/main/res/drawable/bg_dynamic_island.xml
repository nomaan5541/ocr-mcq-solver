<?xml version="1.0" encoding="utf-8"?>
<layer-list xmlns:android="http://schemas.android.com/apk/res/android">
    <!-- Deep Liquid Pill Fill -->
    <item>
        <shape android:shape="rectangle">
            <gradient
                android:startColor="#F0080C18"
                android:centerColor="#F0060A14"
                android:endColor="#F0040810"
                android:angle="180" />
            <corners android:radius="40dp" />
        </shape>
    </item>
    <!-- Inner Glass Highlight -->
    <item android:top="0dp" android:bottom="22dp">
        <shape android:shape="rectangle">
            <gradient
                android:startColor="#10FFFFFF"
                android:endColor="#00FFFFFF"
                android:angle="270" />
            <corners android:radius="40dp" />
        </shape>
    </item>
    <!-- Cyan Glow Border -->
    <item>
        <shape android:shape="rectangle">
            <corners android:radius="40dp" />
            <stroke
                android:width="1.2dp"
                android:color="#4000D4FF" />
        </shape>
    </item>
</layer-list>
