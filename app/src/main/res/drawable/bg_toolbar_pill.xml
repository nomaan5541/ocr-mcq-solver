<?xml version="1.0" encoding="utf-8"?>
<layer-list xmlns:android="http://schemas.android.com/apk/res/android">
    <!-- Liquid Glass Toolbar Pill -->
    <item>
        <shape android:shape="rectangle">
            <gradient
                android:startColor="#F0080C18"
                android:centerColor="#ED060A14"
                android:endColor="#F0040810"
                android:angle="180" />
            <corners android:radius="34dp" />
        </shape>
    </item>
    <item>
        <shape android:shape="rectangle">
            <gradient
                android:startColor="#10FFFFFF"
                android:endColor="#00FFFFFF"
                android:angle="270" />
            <corners android:radius="34dp" />
        </shape>
    </item>
    <item>
        <shape android:shape="rectangle">
            <corners android:radius="34dp" />
            <stroke
                android:width="1dp"
                android:color="#3000D4FF" />
        </shape>
    </item>
</layer-list>
