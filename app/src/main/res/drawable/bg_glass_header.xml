<?xml version="1.0" encoding="utf-8"?>
<layer-list xmlns:android="http://schemas.android.com/apk/res/android">
    <!-- Deep Liquid Glass Header Fill -->
    <item>
        <shape android:shape="rectangle">
            <gradient
                android:startColor="#F00D1424"
                android:centerColor="#ED0A1020"
                android:endColor="#F2060910"
                android:angle="270" />
            <corners
                android:bottomLeftRadius="28dp"
                android:bottomRightRadius="28dp" />
        </shape>
    </item>
    <!-- Specular Top Rim Highlight -->
    <item android:top="0dp">
        <shape android:shape="rectangle">
            <gradient
                android:startColor="#15FFFFFF"
                android:endColor="#00FFFFFF"
                android:angle="270" />
            <corners
                android:bottomLeftRadius="28dp"
                android:bottomRightRadius="28dp" />
        </shape>
    </item>
    <!-- Bottom Rim Border -->
    <item>
        <shape android:shape="rectangle">
            <corners
                android:bottomLeftRadius="28dp"
                android:bottomRightRadius="28dp" />
            <stroke
                android:width="1dp"
                android:color="#25FFFFFF" />
        </shape>
    </item>
</layer-list>
