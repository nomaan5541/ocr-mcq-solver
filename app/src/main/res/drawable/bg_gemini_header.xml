<?xml version="1.0" encoding="utf-8"?>
<layer-list xmlns:android="http://schemas.android.com/apk/res/android">
    <!-- Gemini Header Bar -->
    <item>
        <shape android:shape="rectangle">
            <gradient
                android:startColor="#F00A1424"
                android:endColor="#F0060C18"
                android:angle="270" />
            <corners
                android:topLeftRadius="22dp"
                android:topRightRadius="22dp" />
        </shape>
    </item>
    <item>
        <shape android:shape="rectangle">
            <gradient
                android:startColor="#12FFFFFF"
                android:endColor="#00FFFFFF"
                android:angle="270" />
            <corners
                android:topLeftRadius="22dp"
                android:topRightRadius="22dp" />
        </shape>
    </item>
    <item>
        <shape android:shape="rectangle">
            <corners
                android:topLeftRadius="22dp"
                android:topRightRadius="22dp" />
            <stroke
                android:width="1dp"
                android:color="#25FFFFFF" />
        </shape>
    </item>
</layer-list>
