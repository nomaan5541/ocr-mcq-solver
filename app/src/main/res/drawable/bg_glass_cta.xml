<?xml version="1.0" encoding="utf-8"?>
<layer-list xmlns:android="http://schemas.android.com/apk/res/android">
    <!-- Vibrant Gradient CTA -->
    <item>
        <shape android:shape="rectangle">
            <gradient
                android:startColor="#00D4FF"
                android:centerColor="#6366F1"
                android:endColor="#8B5CF6"
                android:angle="135" />
            <corners android:radius="26dp" />
        </shape>
    </item>
    <!-- Glass Highlight Overlay -->
    <item android:top="0dp" android:left="0dp" android:right="0dp" android:bottom="26dp">
        <shape android:shape="rectangle">
            <gradient
                android:startColor="#40FFFFFF"
                android:endColor="#00FFFFFF"
                android:angle="270" />
            <corners android:radius="26dp" />
        </shape>
    </item>
    <!-- Specular White Border -->
    <item>
        <shape android:shape="rectangle">
            <corners android:radius="26dp" />
            <stroke
                android:width="1.5dp"
                android:color="#60FFFFFF" />
        </shape>
    </item>
</layer-list>
