<?xml version="1.0" encoding="utf-8"?>
<layer-list xmlns:android="http://schemas.android.com/apk/res/android">
    <!-- Crystal Glass Header Fill (Light) -->
    <item>
        <shape android:shape="rectangle">
            <gradient
                android:startColor="#F0FFFFFF"
                android:centerColor="#F0F8FAFC"
                android:endColor="#E8F1F5F9"
                android:angle="270" />
            <corners
                android:bottomLeftRadius="28dp"
                android:bottomRightRadius="28dp" />
        </shape>
    </item>
    <item>
        <shape android:shape="rectangle">
            <gradient
                android:startColor="#50FFFFFF"
                android:endColor="#20FFFFFF"
                android:angle="270" />
            <corners
                android:bottomLeftRadius="28dp"
                android:bottomRightRadius="28dp" />
        </shape>
    </item>
    <item>
        <shape android:shape="rectangle">
            <corners
                android:bottomLeftRadius="28dp"
                android:bottomRightRadius="28dp" />
            <stroke
                android:width="1dp"
                android:color="#3000B8E0" />
        </shape>
    </item>
</layer-list>
