<?xml version="1.0" encoding="utf-8"?>
<layer-list xmlns:android="http://schemas.android.com/apk/res/android">
    <!-- Emerald Crystal Glass (Light) -->
    <item>
        <shape android:shape="rectangle">
            <gradient
                android:startColor="#E0F0FDF4"
                android:endColor="#E0ECFDF5"
                android:angle="270" />
            <corners android:radius="22dp" />
        </shape>
    </item>
    <item>
        <shape android:shape="rectangle">
            <corners android:radius="22dp" />
            <stroke
                android:width="1dp"
                android:color="#5010B981" />
        </shape>
    </item>
</layer-list>
