<?xml version="1.0" encoding="utf-8"?>
<layer-list xmlns:android="http://schemas.android.com/apk/res/android">
    <!-- Scan Button Gradient -->
    <item>
        <shape android:shape="oval">
            <gradient
                android:startColor="#00D4FF"
                android:endColor="#6366F1"
                android:angle="135" />
        </shape>
    </item>
    <item>
        <shape android:shape="oval">
            <stroke
                android:width="1dp"
                android:color="#50FFFFFF" />
        </shape>
    </item>
</layer-list>
