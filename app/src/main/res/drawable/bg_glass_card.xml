<?xml version="1.0" encoding="utf-8"?>
<layer-list xmlns:android="http://schemas.android.com/apk/res/android">
    <!-- Liquid Glass Inner Fill -->
    <item>
        <shape android:shape="rectangle">
            <gradient
                android:startColor="#CC101828"
                android:centerColor="#CC0C1424"
                android:endColor="#CC0A1020"
                android:angle="270" />
            <corners android:radius="22dp" />
        </shape>
    </item>
    <!-- Specular Top Highlight (Glass Reflection) -->
    <item android:top="0dp" android:bottom="0dp">
        <shape android:shape="rectangle">
            <gradient
                android:startColor="#18FFFFFF"
                android:endColor="#00FFFFFF"
                android:angle="270" />
            <corners android:radius="22dp" />
        </shape>
    </item>
    <!-- Liquid Rim Border -->
    <item>
        <shape android:shape="rectangle">
            <corners android:radius="22dp" />
            <stroke
                android:width="1dp"
                android:color="#30FFFFFF" />
        </shape>
    </item>
</layer-list>
