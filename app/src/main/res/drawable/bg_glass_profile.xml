<?xml version="1.0" encoding="utf-8"?>
<layer-list xmlns:android="http://schemas.android.com/apk/res/android">
    <!-- Liquid Glass Profile Circle -->
    <item>
        <shape android:shape="oval">
            <gradient
                android:startColor="#CC121C30"
                android:endColor="#CC0A1424"
                android:angle="270" />
        </shape>
    </item>
    <item>
        <shape android:shape="oval">
            <stroke
                android:width="1.2dp"
                android:color="#30FFFFFF" />
        </shape>
    </item>
</layer-list>
