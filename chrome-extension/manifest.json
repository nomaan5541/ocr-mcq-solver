{
  "manifest_version": 3,
  "name": "Smart Vision Solver - Stealth MCQ",
  "version": "1.8.0",
  "description": "100% Invisible background screen reading, mobile phone haptic sync, screenshot vision solver, draggable ghost HUD, and emergency panic mode.",
  "permissions": [
    "activeTab",
    "storage",
    "contextMenus",
    "cookies",
    "tabs",
    "scripting",
    "offscreen",
    "declarativeNetRequest"
  ],
  "host_permissions": [
    "<all_urls>",
    "https://gemini.google.com/*",
    "https://*.google.com/*",
    "https://generativelanguage.googleapis.com/*",
    "http://localhost:59124/*",
    "http://127.0.0.1:59124/*"
  ],
  "declarative_net_request": {
    "rule_resources": [
      {
        "id": "ruleset_1",
        "enabled": true,
        "path": "rules.json"
      }
    ]
  },
  "content_scripts": [
    {
      "matches": ["https://gemini.google.com/*"],
      "js": ["gemini_content_script.js"],
      "all_frames": true,
      "run_at": "document_idle"
    }
  ],
  "action": {
    "default_icon": {
      "16": "icons/icon_16.png",
      "32": "icons/icon_32.png",
      "48": "icons/icon_48.png",
      "128": "icons/icon_128.png"
    },
    "default_title": "Google Translate"
  },
  "background": {
    "service_worker": "background.js"
  },
  "options_ui": {
    "page": "options.html",
    "open_in_tab": true
  },
  "commands": {
    "_execute_action": {
      "suggested_key": {
        "default": "Alt+Shift+S",
        "mac": "Alt+Shift+S"
      },
      "description": "Instant Stealth Screen Solve"
    },
    "solve_screenshot": {
      "suggested_key": {
        "default": "Alt+Shift+C",
        "mac": "Alt+Shift+C"
      },
      "description": "Instant Screenshot / Canvas Solve"
    },
    "emergency_panic": {
      "suggested_key": {
        "default": "Ctrl+Shift+Q",
        "mac": "Command+Shift+Q"
      },
      "description": "Emergency Panic Mode Reset"
    }
  }
}
